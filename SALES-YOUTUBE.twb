      <aliases enabled='yes' />
      <column caption='YTD Sales' datatype='real' name='[Calculation_3038778639638538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = &#10;{ FIXED : MAX(YEAR([Order Date])) }&#10;THEN [Sales]&#10;END' />
      </column>
      <column caption='% Difffrence ' datatype='real' name='[Calculation_3038778811633681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_3038778639638538])-SUM([YTD Sales (copy)_3038778811355152]))/SUM([YTD Sales (copy)_3038778811355152])' />
      </column>
      <column caption='Sales Margin' datatype='string' name='[Calculation_3038778816786451]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_3038778639638538]) - SUM([YTD Sales (copy)_3038778811355152])&lt;0 THEN &apos;Less than PY&apos;&#10;ELSEIF SUM([Calculation_3038778639638538]) - SUM([YTD Sales (copy)_3038778811355152])&gt;0 THEN &apos;Greater than PY&apos;&#10;ELSEIF ISNULL(SUM([YTD Sales (copy)_3038778811355152])) THEN &apos;No sales in PY&apos;&#10;END' />
      </column>
      <column caption='Positive % diffrence ' datatype='string' name='[Calculation_3038778819387412]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3038778811633681]&gt;0 THEN &apos;▲&apos; END' />
      </column>
      <column caption='NEGATIVE % DIFFRENCE ' datatype='string' name='[Calculation_3038778823135253]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3038778811633681]&lt;0 THEN &apos;🔻&apos; END' />
      </column>
      <column caption='NO SALES ' datatype='string' name='[Calculation_3038778823958550]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3038778816786451] = &apos;No sales in PY&apos; THEN &apos;no sales in previous year&apos; END' />
      </column>
      <column caption='ytd sales LOD' datatype='real' name='[Calculation_5788793577943040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#10;    SUM(&#10;        IF YEAR([Order Date]) =&#10;           { FIXED : MAX(YEAR([Order Date])) }&#10;        THEN [Sales]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='YOY Sales %' datatype='real' name='[Calculation_5788793580802050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5788793577943040] - [ytd sales LOD (copy)_5788793580244993])/[ytd sales LOD (copy)_5788793580244993]' />
      </column>
      <column caption='YOY Sales margin' datatype='string' name='[Calculation_5788793605976067]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5788793580802050]&gt;0 THEN &apos;🔺&apos;  ELSEIF [Calculation_5788793580802050]&lt;0 THEN &apos;🔻&apos; END' />
      </column>
      <column datatype='string' name='[Customer City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Customer Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='integer' name='[Customer Id]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Customer State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Customer Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='string' name='[Market]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Order Id]' role='dimension' type='ordinal' />
      <column caption='Pytd Profit LOD ' datatype='real' name='[Pytd sales LOD (copy)_5788793615257605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#10;    SUM(&#10;        IF YEAR([Order Date]) =&#10;           { FIXED : MAX(YEAR([Order Date]))-1 }&#10;        THEN [Profit Per Order]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Pytd ORDER QUANTITY LOD ' datatype='integer' name='[Pytd sales LOD (copy)_5788793634459659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#10;    SUM(&#10;        IF YEAR([Order Date]) =&#10;           { FIXED : MAX(YEAR([Order Date]))-1 }&#10;        THEN [Order Quantity]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='YOY order% (copy)' datatype='real' name='[YOY Sales % (copy)_3038778616135682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([ytd sales LOD (copy)_5788793632460810] - [Pytd sales LOD (copy)_5788793634459659])/[Pytd sales LOD (copy)_5788793634459659]' />
      </column>
      <column caption='YOY ORDER % ' datatype='real' name='[YOY Sales % (copy)_5788793637396492]' role='measure' type='quantitative'>
